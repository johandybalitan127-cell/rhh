# ==============================================================================
# CONFIGURACIÓN GENERAL - PORTAL DE RRHH (COSTA RICA)
# ==============================================================================

# Entorno de ejecución
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Base de datos PostgreSQL
# Formato: postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rrhh_costarica
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/rrhh_costarica

# Seguridad y Autenticación JWT
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# APIs de Inteligencia Artificial
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# Clave de servidor para https://api.deepseek.com/ (no usar en el frontend)
DEEPSEEK_API_KEY=tu_clave_de_deepseek_aqui
EMBEDDING_MODEL=models/text-embedding-004
LLM_MODEL=gemini-2.0-flash

# Google Drive API (Ingesta de documentos)
GOOGLE_DRIVE_FOLDER_ID=tu_folder_id_de_google_drive
GOOGLE_CREDENTIALS_FILE=credentials.json

# Parámetros del Negocio Ficticio (Costa Rica)
EMPRESA_NOMBRE=TecnoCR Soluciones S.A.
EMPRESA_CEDULA_JURIDICA=3-101-789456
HORA_REPORTE_AUTOMATICO=07:00
